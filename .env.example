# .env.example
# Copy this file to .env and fill in values as needed.
# This project uses no secret credentials — all variables below are optional configuration.

# --- Display / GUI Forwarding ---
# Required for pygame rendering when running inside Docker on Linux.
# On Windows with VcXsrv/Xming, use: host.docker.internal:0
# On Linux (native), use: :0 or leave as the system default.
DISPLAY=host.docker.internal:0

# --- Training Configuration ---
# These can be overridden via CLI arguments to train.py / evaluate.py.
# They are listed here for documentation purposes only.
TRAIN_TIMESTEPS=200000
REWARD_TYPE=shaped
SAVE_PATH=models/ppo_shaped.zip
MODEL_PATH=models/ppo_shaped.zip

# --- Pygame (headless mode) ---
# Set to "dummy" in Docker to suppress display errors when using xvfb
SDL_VIDEODRIVER=dummy
